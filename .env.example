# ============================================================
# TradeVision AI - Backend - Variables d'environnement
# Copiez ce fichier en ".env" et renseignez de VRAIES valeurs.
# Ne JAMAIS committer le fichier ".env" (déjà exclu via .gitignore).
# ============================================================

# "development" ou "production".
# En "production", JWT_SECRET DOIT être défini ou le démarrage échoue (fail-fast).
ENVIRONMENT=development

# ── Twelve Data ────────────────────────────────────────────
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_API_KEY_1=your_twelve_data_key_1_here
TWELVE_DATA_API_KEY_2=your_twelve_data_key_2_here
# Bornées automatiquement entre 60 et 300 secondes.
TWELVE_DATA_COOLDOWN_SECONDS=60
TWELVE_DATA_EXHAUSTED_SECONDS=300

# ── OpenRouter (validation IA) ──────────────────────────────
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free

# ── Base de données ──────────────────────────────────────────
DATABASE_URL=sqlite:///./tradevision.db

# ── Firebase (notifications push) ───────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── JWT / Authentification ──────────────────────────────────
# OBLIGATOIRE en production. Générez une valeur aléatoire forte, ex :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change_me_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Timeframes ───────────────────────────────────────────────
MAIN_TIMEFRAME=1h
CONFIRMATION_TIMEFRAME=4h

# ── Stratégie ──────────────────────────────────────────────
MIN_CONFIDENCE=70
# Intervalle (en minutes) de l'Auto-Scan serveur en arrière-plan.
REFRESH_INTERVAL=15

# ── CORS ───────────────────────────────────────────────────
# "*" en développement. En production, listez vos domaines séparés par des virgules,
# ex : CORS_ORIGINS=https://app.tradevision.ai,https://admin.tradevision.ai
CORS_ORIGINS=*

# ── News / Calendrier économique ────────────────────────────
NEWS_RSS_URL=
ECONOMIC_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
